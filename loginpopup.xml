<extension type="plugin" version="3.0" group="system" method="upgrade">
	<name>plg_system_loginpopup</name>
	<author>Jayden Russell</author>
	<creationDate>October 2014</creationDate>
	<copyright>Copyright (c) 2014 ExtStore. Copyright (c) 2026 Jayden Russell. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>jaydenrussell@users.noreply.github.com</authorEmail>
	<authorUrl>https://github.com/jaydenrussell</authorUrl>
	<version>3.0.4</version>
	<description>
	<![CDATA[
		Enhanced Login Popup — Modern layout with club branding, password toggle, customizable title, full-page blur, responsive design, and dynamic page-based redirect rules (subform-driven). Originally based on ExtStore Login Popup v1.0.1 for Joomla 3.x.
	]]>
	</description>

	<updateserver>https://raw.githubusercontent.com/jaydenrussell/plg_system_loginpopup/master/updates.xml</updateserver>

	<files>
		<folder>layouts</folder>
		<filename plugin="loginpopup">loginpopup.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
	</files>

	<media folder="media" destination="plg_system_loginpopup">
		<folder>css</folder>
		<folder>images</folder>
		<folder>js</folder>
		<filename>index.html</filename>
	</media>

	<languages>
		<language tag="en-GB">en-GB.plg_system_loginpopup.ini</language>
		<language tag="en-GB">en-GB.plg_system_loginpopup.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="layout"
					type="list"
					default="default"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_LAYOUT_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_LAYOUT_DESC"
				>
					<option value="default">PLG_SYSTEM_LOGINPOPUP_LAYOUT_DEFAULT</option>
					<option value="modern">PLG_SYSTEM_LOGINPOPUP_LAYOUT_MODERN</option>
				</field>

				<field
					name="logo"
					type="media"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGO_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGO_DESC"
					default=""
				/>

				<field
					name="logo_size"
					type="list"
					default="medium"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGO_SIZE_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGO_SIZE_DESC"
				>
					<option value="small">PLG_SYSTEM_LOGINPOPUP_LOGO_SMALL</option>
					<option value="medium">PLG_SYSTEM_LOGINPOPUP_LOGO_MEDIUM</option>
					<option value="large">PLG_SYSTEM_LOGINPOPUP_LOGO_LARGE</option>
				</field>

				<field
					name="modal_position"
					type="list"
					default="center"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_MODAL_POSITION_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_MODAL_POSITION_DESC"
				>
					<option value="top">PLG_SYSTEM_LOGINPOPUP_POSITION_TOP</option>
					<option value="center">PLG_SYSTEM_LOGINPOPUP_POSITION_CENTER</option>
					<option value="bottom">PLG_SYSTEM_LOGINPOPUP_POSITION_BOTTOM</option>
					<option value="custom">PLG_SYSTEM_LOGINPOPUP_POSITION_CUSTOM</option>
				</field>

				<field
					name="modal_top_offset"
					type="text"
					default="50"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_MODAL_TOP_OFFSET_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_MODAL_TOP_OFFSET_DESC"
				/>

				<field
					name="unblur_header"
					type="radio"
					class="btn-group btn-group-yesno"
					default="1"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_UNBLUR_HEADER_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_UNBLUR_HEADER_DESC"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="unblur_selector"
					type="text"
					default="#astroid-header, #astroid-sticky-header, .astroid-header, .astroid-topbar, header, .navbar, .astroid-module-position.top-header-navbar"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_UNBLUR_SELECTOR_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_UNBLUR_SELECTOR_DESC"
				/>

				<!-- Modern Layout Customization -->
				<field
					name="custom_title_enabled"
					type="radio"
					class="btn-group btn-group-yesno"
					default="1"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_CUSTOM_TITLE_ENABLED_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_CUSTOM_TITLE_ENABLED_DESC"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="custom_title_text"
					type="textarea"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_CUSTOM_TITLE_TEXT_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_CUSTOM_TITLE_TEXT_DESC"
					default="Welcome Back"
					filter="safehtml"
					rows="3"
					cols="40"
				/>

				<field
					name="remember_display"
					type="list"
					default="show_checked"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_REMEMBER_DISPLAY_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_REMEMBER_DISPLAY_DESC"
				>
					<option value="show_checked">PLG_SYSTEM_LOGINPOPUP_REMEMBER_SHOW_CHECKED</option>
					<option value="show_unchecked">PLG_SYSTEM_LOGINPOPUP_REMEMBER_SHOW_UNCHECKED</option>
					<option value="hide_checked">PLG_SYSTEM_LOGINPOPUP_REMEMBER_HIDE_CHECKED</option>
					<option value="hide_unchecked">PLG_SYSTEM_LOGINPOPUP_REMEMBER_HIDE_UNCHECKED</option>
				</field>

				<field
					name="signup_text"
					type="text"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_SIGNUP_TEXT_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_SIGNUP_TEXT_DESC"
					default="New to SCC?"
				/>

				<field
					name="signup_link_text"
					type="text"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_SIGNUP_LINK_TEXT_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_SIGNUP_LINK_TEXT_DESC"
					default="Sign up"
				/>

				<field
					name="selector"
					type="text"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_SELECTOR_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_SELECTOR_DESC"
					default="a[href=#login], a[href=#logout]"
				/>

				<field
					name="offset_top"
					type="text"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_OFFSET_TOP_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_OFFSET_TOP_DESC"
					default="50"
				/>

				<field
					name="login"
					type="menuitem"
					disable="separator"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGIN_REDIRECTURL_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGIN_REDIRECTURL_DESC"
				>
					<option value="">JDEFAULT</option>
				</field>

				<field
					name="logout"
					type="menuitem"
					disable="separator"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGOUT_REDIRECTURL_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_LOGOUT_REDIRECTURL_DESC"
				>
					<option value="">JDEFAULT</option>
				</field>

				<field
					name="greeting"
					type="radio"
					class="btn-group btn-group-yesno"
					default="1"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_GREETING_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_GREETING_DESC"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="name"
					type="list"
					default="0"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_NAME_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_NAME_DESC"
				>
					<option value="0">PLG_SYSTEM_LOGINPOPUP_VALUE_NAME</option>
					<option value="1">PLG_SYSTEM_LOGINPOPUP_VALUE_USERNAME</option>
				</field>

				<field
					name="usesecure"
					type="radio"
					class="btn-group btn-group-yesno"
					default="0"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_USESECURE_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_USESECURE_DESC"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>
			</fieldset>

			<fieldset name="redirect" label="PLG_SYSTEM_LOGINPOPUP_FIELDSET_REDIRECT_LABEL">
				<field
					name="redirect_enabled"
					type="radio"
					class="btn-group btn-group-yesno"
					default="0"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_REDIRECT_ENABLED_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_REDIRECT_ENABLED_DESC"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="redirect_map"
					type="subform"
					label="PLG_SYSTEM_LOGINPOPUP_FIELD_REDIRECT_MAP_LABEL"
					description="PLG_SYSTEM_LOGINPOPUP_FIELD_REDIRECT_MAP_DESC"
					multiple="true"
					min="0"
					max="50"
					formsource="plugins/system/loginpopup/layouts/fields/redirect_map.xml"
				/>
			</fieldset>
		</fields>
	</config>
</extension>